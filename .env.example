# Lab Report Formatting Agent — Environment Configuration
# Copy this file to .env and fill in your values.

# Optional: Gemini Vision API key for Read Mode (screenshot text extraction)
# Get a free key at https://aistudio.google.com
# If not set, the app falls back to Embed Mode (insert image directly)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Database path (defaults to lab_reports.db in project root)
# DB_PATH=/path/to/your/lab_reports.db

# Optional: Session secret key (not currently used by SQLite session store,
# reserved for future JWT or cookie signing)
# SECRET_KEY=change_this_to_a_random_secret
